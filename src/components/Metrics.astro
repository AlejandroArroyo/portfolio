---
import content from '../data/content.json';

const { metrics } = content;
---

<section class="border-b border-neutral-900 bg-neutral-950">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-8 lg:gap-12 divide-y md:divide-y-0 md:divide-x divide-neutral-900">
      
      {metrics.map((metric, i) => (
        <div class={`${i > 0 ? 'pt-8 md:pt-0 md:pl-8' : 'pt-6 md:pt-0 md:pl-0'} flex flex-col justify-between`}>
          <span class="text-xs font-mono text-brand-accent tracking-wider uppercase mb-2">// {metric.label}</span>
          <div class="flex items-baseline gap-1">
            <span class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-neutral-100 tracking-tight leading-none" set:html={metric.value}></span>
            {metric.suffix && <span class="text-neutral-500 font-mono text-base lg:text-lg">{metric.suffix}</span>}
          </div>
          <p class="text-sm text-neutral-400 mt-3 leading-relaxed">{metric.description}</p>
        </div>
      ))}

    </div>
  </div>
</section>
