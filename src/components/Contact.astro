---
import content from '../data/content.json';

const { contact, footer } = content;
---

<section id="contacto" class="py-16 sm:py-20 lg:py-28 bg-brand-dark border-b border-neutral-900 relative">
  <div class="absolute bottom-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-accent/5 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Cabecera de sección -->
    <div class="mb-10 sm:mb-12 text-center">
      <div class="inline-flex items-center gap-2 mb-4 px-3 py-1 bg-brand-surface border border-neutral-800 rounded-full">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-accent"></span>
        </span>
        <span class="text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-widest">
          {contact.badge}
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-neutral-100 tracking-tight leading-none mt-2">
        {contact.title}
      </h2>
      <p class="text-neutral-400 mt-3 sm:mt-4 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
        {contact.description}
      </p>
    </div>

    <!-- Tarjeta de conexión tipo terminal -->
    <div class="max-w-4xl mx-auto bg-brand-surface border border-neutral-800 rounded overflow-hidden shadow-2xl">
      <!-- Barra superior de terminal -->
      <div class="bg-neutral-950 border-b border-neutral-800 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-neutral-800 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-800 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-800 inline-block"></span>
        </div>
        <span class="text-[10px] font-mono text-neutral-500 font-bold uppercase tracking-wider">{contact.terminalTitle}</span>
        <div class="w-12"></div>
      </div>

      <!-- Cuerpo de terminal -->
      <div class="p-4 sm:p-6 lg:p-8 font-mono text-xs sm:text-sm text-neutral-400 space-y-4">
        <div>
          <p class="text-neutral-500">{contact.connectMessage}</p>
          <p class="text-brand-accent">{contact.connectResponse}</p>
        </div>

        <div class="border-t border-neutral-900 pt-4 space-y-3">
          <p class="text-neutral-300 font-bold uppercase">{contact.channelsTitle}</p>
          
          <!-- Correo electrónico -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 py-2 border-b border-neutral-900">
            <span class="text-neutral-500">{contact.email.label}</span>
            <a 
              href={`mailto:${contact.email.value}`} 
              class="text-neutral-200 hover:text-brand-accent transition-colors focus:outline-none"
            >
              {contact.email.value}
            </a>
          </div>

          <!-- LinkedIn -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 py-2 border-b border-neutral-900">
            <span class="text-neutral-500">{contact.linkedin.label}</span>
            <a 
              href={contact.linkedin.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-neutral-200 hover:text-brand-accent transition-colors focus:outline-none flex items-center gap-1"
            >
              {contact.linkedin.value} <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div>

          <!-- Ubicación -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 py-2 border-b border-neutral-900">
            <span class="text-neutral-500">{contact.location.label}</span>
            <span class="text-neutral-200">{contact.location.value}</span>
          </div>
        </div>

        <div class="pt-4 flex flex-wrap gap-4 items-center justify-between">
          <span class="text-[10px] text-neutral-600 uppercase">{contact.sessionId}</span>
          <div class="flex gap-3">
            <button 
              onclick={`navigator.clipboard.writeText('${contact.email.value}'); alert('Correo copiado al portapapeles.');`}
              class="px-4 py-2 border border-neutral-800 bg-neutral-950 hover:bg-neutral-900 rounded font-mono text-[11px] text-neutral-300 hover:text-brand-accent hover:border-brand-accent/40 transition-all focus:outline-none"
            >
              {contact.copyButton}
            </button>
            <a 
              href={`mailto:${contact.email.value}`}
              class="px-4 py-2 bg-brand-accent text-neutral-950 rounded font-mono text-[11px] font-bold hover:bg-brand-accent/90 transition-all focus:outline-none"
            >
              {contact.contactButton}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pie de página -->
<footer class="bg-neutral-950 py-10 sm:py-12 border-t border-neutral-900">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex flex-col">
      <span class="text-xs font-mono font-bold text-neutral-400">{footer.brand}</span>
      <span class="text-[10px] font-mono text-neutral-600 mt-1">{footer.copyright}</span>
    </div>
    
    <div class="text-[11px] font-mono text-neutral-500 flex items-center gap-4">
      {footer.tech.map((t, i) => (
        <>
          {i > 0 && <span>•</span>}
          <span>{t}</span>
        </>
      ))}
    </div>
  </div>
</footer>
