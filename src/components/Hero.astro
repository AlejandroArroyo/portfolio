---
import content from '../data/content.json';

const { hero } = content;
---

<section id="sobre-mi" class="relative py-16 sm:py-24 lg:py-32 overflow-hidden border-b border-neutral-900">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(16,185,129,0.10),transparent_30%),radial-gradient(circle_at_82%_12%,rgba(6,182,212,0.08),transparent_28%)]"></div>
  <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-incident/30 to-transparent"></div>
  <div class="absolute -right-24 top-28 h-72 w-72 rounded-full border border-brand-accent/10 opacity-60"></div>
  <div class="absolute -right-10 top-44 h-44 w-44 rounded-full border border-brand-incident/10 opacity-60"></div>
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Etiqueta superior -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <span class="text-xs font-mono text-brand-accent font-bold uppercase tracking-widest">[ {hero.badgeText} ]</span>
      <span class="w-8 h-[1px] bg-neutral-800"></span>
      <span class="text-xs font-mono text-neutral-500 uppercase tracking-wider">{hero.badgeSubtitle}</span>
    </div>

    <!-- Titular principal -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl xl:text-7xl font-extrabold text-neutral-100 tracking-tight leading-[1.02] max-w-[1180px] mb-8 sm:mb-10" set:html={hero.title}></h1>

    <!-- Cuerpo narrativo -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-start">
      <div class="lg:col-span-8 text-neutral-400 text-base sm:text-lg leading-relaxed space-y-6 max-w-4xl">
        <p>{hero.description1}</p>
        <p>{hero.description2}</p>
      </div>
      
      <!-- Panel lateral: Valores clave -->
      <div class="lg:col-span-4 bg-brand-surface/90 border border-neutral-800 p-5 sm:p-6 rounded relative overflow-hidden group shadow-2xl shadow-black/30">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-brand-accent/70 via-brand-incident/60 to-transparent"></div>
        <div class="absolute -right-16 -top-16 h-36 w-36 rounded-full bg-brand-accent/10 blur-3xl transition-opacity duration-500 group-hover:opacity-80"></div>
        <div class="space-y-6">
          <div>
            <h3 class="text-xs font-mono text-brand-accent uppercase tracking-widest mb-1">// {hero.valuesTitle}</h3>
            <p class="text-xs text-neutral-400">{hero.valuesDescription}</p>
          </div>
          
          <ul class="space-y-3 font-mono text-xs text-neutral-300">
            {hero.values.map((val, i) => (
              <li class="flex items-center gap-3 rounded border border-neutral-900/80 bg-neutral-950/35 px-3 py-2 transition-colors hover:border-brand-accent/25 hover:bg-neutral-950/60">
                <span class="text-brand-accent">0{i + 1}.</span>
                <span>{val}</span>
              </li>
            ))}
          </ul>

          <div class="pt-4 border-t border-neutral-800 flex items-center justify-between text-[11px] font-mono text-neutral-500">
            <span>{hero.slaLabel}</span>
            <span>{hero.slaValue}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
