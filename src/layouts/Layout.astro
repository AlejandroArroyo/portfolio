---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Analista de Ciberseguridad & Ex-Dev con 8 años en NTT DATA. Especialista en SOC con visión de negocio: entiendo qué activo del cliente está en riesgo y cómo protegerlo. CCNA, CyberOps, Fortinet FCP.",
  ogImage = "/og-image.svg"
} = Astro.props;

const siteUrl = "https://alejandroarroyogil.com";
const canonicalUrl = Astro.url.pathname === "/" ? siteUrl : `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />

    <!-- Google Fonts: Inter and JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-brand-dark text-neutral-200 font-sans selection:bg-brand-accent/20 selection:text-brand-accent overflow-x-hidden antialiased">
    <!-- Fondo sutil de rejilla -->
    <div class="fixed inset-0 pointer-events-none bg-[linear-gradient(to_right,#1f29370a_1px,transparent_1px),linear-gradient(to_bottom,#1f29370a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] z-0"></div>
    
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <style is:global>
      /* Barra de desplazamiento personalizada */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #070708;
      }
      ::-webkit-scrollbar-thumb {
        background: #1a1a1e;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #2e2e33;
      }

      /* Estilos de foco para accesibilidad */
      *:focus-visible {
        outline: 2px solid #10b981;
        outline-offset: 4px;
      }
    </style>
  </body>
</html>
